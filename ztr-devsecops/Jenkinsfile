pipeline {
    agent any

    environment {
        BASE_DIR    = 'ztr-devsecops'
        APP_NAME    = 'juiceshop'
        NAMESPACE   = 'devsecops'
        REPORT_DIR  = 'reports'
        HEAL_DIR    = 'healed-manifests'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // ============================================================
        // STAGE 1: Checkout
        // ============================================================
        stage('Checkout Source') {
            steps {
                echo '========================================='
                echo ' STAGE 1: Checking out source code'
                echo '========================================='
                checkout scm
            }
        }

        // ============================================================
        // STAGE 2: Verify Environment
        // ============================================================
        stage('Verify Environment') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 2: Verifying tools'
                    echo '========================================='
                    sh '''
                    echo "Hostname: $(hostname)"
                    echo "Git:       $(git --version)"
                    echo "Docker:    $(docker --version)"
                    echo "Kubectl:   $(kubectl version --client --short 2>/dev/null || kubectl version --client 2>&1 | head -1)"
                    echo "Trivy:     $(trivy --version 2>&1 | head -1)"
                    echo "Python:    $(python3 --version)"
                    echo ""
                    echo "Kubernetes Cluster Info:"
                    kubectl cluster-info 2>&1 || echo "WARNING: Cannot reach K8s cluster"
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 3: Create Reports Directory
        // ============================================================
        stage('Prepare Directories') {
            steps {
                dir("${BASE_DIR}") {
                    sh 'mkdir -p reports healed-manifests'
                }
            }
        }

        // ============================================================
        // STAGE 4: Deploy to Kubernetes
        // ============================================================
        stage('Deploy to Kubernetes') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 4: Deploying to K8s cluster'
                    echo '========================================='
                    sh '''
                    chmod +x scripts/deploy.sh
                    ./scripts/deploy.sh
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 5: Security Scan (Trivy)
        // ============================================================
        stage('Security Scan') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 5: Running Trivy security scans'
                    echo '========================================='
                    sh '''
                    chmod +x scripts/trivy_scan.sh
                    ./scripts/trivy_scan.sh
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 6: Parse Scan Results
        // ============================================================
        stage('Parse Scan Results') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 6: Parsing vulnerability data'
                    echo '========================================='
                    sh '''
                    python3 scripts/parser.py reports/trivy-image-report.json
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 7: AI Vulnerability Analysis
        // ============================================================
        stage('AI Vulnerability Analysis') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 7: AI-powered vulnerability analysis'
                    echo '========================================='
                    sh '''
                    if [ -f reports/trivy-image-report.json ]; then
                        CRITICAL=$(python3 -c "
import json
try:
    with open('reports/trivy-image-report.json') as f:
        data = json.load(f)
    results = data.get('Results', [])
    total = 0
    for r in results:
        for v in r.get('Vulnerabilities', []):
            if v.get('Severity') == 'CRITICAL':
                total += 1
    print(total)
except: print(0)
")
                        HIGH=$(python3 -c "
import json
try:
    with open('reports/trivy-image-report.json') as f:
        data = json.load(f)
    results = data.get('Results', [])
    total = 0
    for r in results:
        for v in r.get('Vulnerabilities', []):
            if v.get('Severity') == 'HIGH':
                total += 1
    print(total)
except: print(0)
")
                        MEDIUM=$(python3 -c "
import json
try:
    with open('reports/trivy-image-report.json') as f:
        data = json.load(f)
    results = data.get('Results', [])
    total = 0
    for r in results:
        for v in r.get('Vulnerabilities', []):
            if v.get('Severity') == 'MEDIUM':
                total += 1
    print(total)
except: print(0)
")
                        LOW=$(python3 -c "
import json
try:
    with open('reports/trivy-image-report.json') as f:
        data = json.load(f)
    results = data.get('Results', [])
    total = 0
    for r in results:
        for v in r.get('Vulnerabilities', []):
            if v.get('Severity') == 'LOW':
                total += 1
    print(total)
except: print(0)
")

                        echo ""
                        echo "========================================="
                        echo "  VULNERABILITY SUMMARY (AI Analysis)"
                        echo "========================================="
                        echo "  CRITICAL:  ${CRITICAL}"
                        echo "  HIGH:      ${HIGH}"
                        echo "  MEDIUM:    ${MEDIUM}"
                        echo "  LOW:       ${LOW}"
                        echo "========================================="
                        echo ""

                        # Generate AI analysis report
                        python3 scripts/parser.py reports/trivy-image-report.json --analysis
                    else
                        echo "No scan report found. Skipping analysis."
                    fi
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 8: Self-Healing (Auto-Remediation)
        // ============================================================
        stage('Self-Healing Remediation') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 8: Self-Healing - Applying fixes'
                    echo '========================================='
                    sh '''
                    chmod +x scripts/heal.sh
                    ./scripts/heal.sh
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 9: Re-deploy Fixed Manifests
        // ============================================================
        stage('Re-deploy Fixed Manifests') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 9: Re-deploying healed manifests'
                    echo '========================================='
                    sh '''
                    kubectl apply -f healed-manifests/ -n ${NAMESPACE} 2>&1 || echo "No healed manifests to apply"
                    sleep 10
                    kubectl rollout status deployment/nginx -n ${NAMESPACE} --timeout=120s 2>&1 || true
                    kubectl rollout status deployment/juiceshop -n ${NAMESPACE} --timeout=120s 2>&1 || true
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 10: Post-Healing Verification Scan
        // ============================================================
        stage('Post-Healing Verification') {
            steps {
                dir("${BASE_DIR}") {
                    echo '========================================='
                    echo ' STAGE 10: Re-scanning to verify fixes'
                    echo '========================================='
                    sh '''
                    trivy image --format json -o reports/trivy-post-heal-report.json \
                        bkimminich/juice-shop:latest 2>/dev/null || true

                    echo ""
                    echo "========================================="
                    echo "  POST-HEALING SCAN COMPLETE"
                    echo "========================================="
                    echo "  Reports saved to reports/"
                    echo "  - trivy-image-report.json (before)"
                    echo "  - trivy-post-heal-report.json (after)"
                    echo "  - vulnerability-report.txt"
                    echo "  - ai-analysis-report.txt"
                    echo "========================================="
                    '''
                }
            }
        }

        // ============================================================
        // STAGE 11: Show K8s Cluster State
        // ============================================================
        stage('Cluster Status') {
            steps {
                dir("${BASE_DIR}") {
                    sh '''
                    echo ""
                    echo "========================================="
                    echo "  KUBERNETES CLUSTER STATE"
                    echo "========================================="
                    echo ""
                    echo "--- Pods ---"
                    kubectl get pods -n ${NAMESPACE}
                    echo ""
                    echo "--- Services ---"
                    kubectl get svc -n ${NAMESPACE}
                    echo ""
                    echo "--- Deployments ---"
                    kubectl get deployments -n ${NAMESPACE}
                    echo ""
                    echo "--- Nodes ---"
                    kubectl get nodes
                    echo ""
                    echo "--- Access Points ---"
                    echo "Juice Shop: http://$(minikube ip):$(kubectl get svc -n ${NAMESPACE} juiceshop-service -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo 30000)"
                    echo "Nginx:       http://$(minikube ip):$(kubectl get svc -n ${NAMESPACE} nginx-service -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo 30001)"
                    echo "========================================="
                    '''
                }
            }
        }
    }

    post {
        always {
            dir("${BASE_DIR}") {
                archiveArtifacts artifacts: 'reports/**', fingerprint: true, allowEmptyArchive: true
                archiveArtifacts artifacts: 'healed-manifests/**', fingerprint: true, allowEmptyArchive: true
            }
            echo 'Pipeline Finished'
        }
        success {
            echo 'Pipeline Completed Successfully!'
        }
        failure {
            echo 'Pipeline Failed - Check logs above for details'
        }
    }
}
